{
	"name": "madfarm-advisors-site",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "Madfarm Advisors website",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"visual-diff": "node scripts/visual-diff.mjs"
	},
	"dependencies": {
		"mailersend": "^2.3.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"pixelmatch": "^7.0.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.12",
		"vitest": "^4.1.8"
	}
}
