{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "sveltekit",
	"redirects": [
		{ "source": "/home", "destination": "/", "permanent": true },
		{ "source": "/home/", "destination": "/", "permanent": true },
		{ "source": "/guide-valuations", "destination": "/resources", "permanent": true },
		{ "source": "/guide-valuations/", "destination": "/resources", "permanent": true },
		{ "source": "/ma-acronym-glossary", "destination": "/resources", "permanent": true },
		{ "source": "/ma-acronym-glossary/", "destination": "/resources", "permanent": true },
		{ "source": "/guide-timeline", "destination": "/process", "permanent": true },
		{ "source": "/guide-timeline/", "destination": "/process", "permanent": true },
		{ "source": "/index.html", "destination": "/", "permanent": true },
		{ "source": "/process.html", "destination": "/process", "permanent": true },
		{ "source": "/about.html", "destination": "/about", "permanent": true },
		{ "source": "/case-studies.html", "destination": "/case-studies", "permanent": true },
		{
			"source": "/case-industrial.html",
			"destination": "/case-studies/industrial",
			"permanent": true
		},
		{ "source": "/case-hvac.html", "destination": "/case-studies/hvac", "permanent": true },
		{ "source": "/case-carveout.html", "destination": "/case-studies/carveout", "permanent": true },
		{ "source": "/case-saas.html", "destination": "/case-studies/saas", "permanent": true },
		{ "source": "/resources.html", "destination": "/resources", "permanent": true },
		{ "source": "/contact.html", "destination": "/contact", "permanent": true },
		{ "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true }
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{ "key": "Strict-Transport-Security", "value": "max-age=63072000" },
				{ "key": "X-Frame-Options", "value": "SAMEORIGIN" },
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
				},
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://calendar.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
				}
			]
		},
		{
			"source": "/fonts/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		}
	]
}
